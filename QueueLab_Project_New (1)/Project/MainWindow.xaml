<Window x:Class="QueueSimulatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QueueLab - Queueing Model Calculator" Height="900" Width="1180"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBg}">

    <!--
        Two states:
          1. START SCREEN  - project name + one drop-down (M/M/1, M/G/1, G/G/1), all centred.
          2. MODEL SCREEN  - the page of the chosen model. The navbar shows a drop-down to switch the
                             model and a Back button to go back to the start screen.
    -->
    <DockPanel>

        <!-- ================= NAVBAR (only visible after a model is chosen) ================= -->
        <Border x:Name="navBar" DockPanel.Dock="Top" Background="{StaticResource NavBg}" Padding="30,0"
                Visibility="Collapsed">
            <DockPanel Height="64">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Accent}">
                        <TextBlock Text="Q" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="QueueLab" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Single-server queueing models" Foreground="#9FB0D0" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <ComboBox x:Name="cmbSwitch" Width="340" Height="36" FontSize="13"
                              VerticalContentAlignment="Center" SelectionChanged="Model_Changed">
                        <ComboBoxItem Content="M/M/1  (Poisson arrivals, exponential service)"/>
                        <ComboBoxItem Content="M/G/1  (Poisson arrivals, general service)"/>
                        <ComboBoxItem Content="G/G/1  (general arrivals and service)"/>
                    </ComboBox>
                    <Button Content="←  Back" Style="{StaticResource NavButton}" Margin="10,0,0,0" Click="Back_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= FOOTER ================= -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="30,10">
            <TextBlock Text="QueueLab  ·  M/M/1, M/G/1 and G/G/1  ·  Stability condition: ρ &lt; 1"
                       Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
        </Border>

        <!-- ================= BODY ================= -->
        <Grid>

            <!-- ========== START SCREEN (centred) ========== -->
            <Grid x:Name="landing">
                <StackPanel Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource HeroBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="Q" Foreground="White" FontSize="40" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="QueueLab" FontSize="40" FontWeight="Bold" Foreground="{StaticResource TextDark}"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="Queueing Model Calculator" FontSize="16" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,2,0,28"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Select Queueing Model" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Pick a model - its inputs and results will open."
                                       Style="{StaticResource HintText}" Margin="0,0,0,12"/>
                            <Grid>
                                <ComboBox x:Name="cmbModel" Style="{StaticResource InputCombo}"
                                          SelectedIndex="-1" SelectionChanged="Model_Changed">
                                    <ComboBoxItem Content="M/M/1  (Poisson arrivals, exponential service)"/>
                                    <ComboBoxItem Content="M/G/1  (Poisson arrivals, general service)"/>
                                    <ComboBoxItem Content="G/G/1  (general arrivals and service)"/>
                                </ComboBox>
                                <!-- placeholder shown while nothing is selected -->
                                <TextBlock x:Name="txtPlaceholder" Text="Choose a model..." FontSize="14"
                                           Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="12,0,30,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ========== MODEL SCREEN ========== -->
            <ScrollViewer x:Name="pageScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="1100" Margin="30,24,30,30" HorizontalAlignment="Stretch">
                    <ContentControl x:Name="pageHost" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</Window>
